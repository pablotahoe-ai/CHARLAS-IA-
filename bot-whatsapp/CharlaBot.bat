rem=0/*
@echo off
cls
setlocal
title CharlaBot - WhatsApp en vivo (pantalla 29/50)
echo.
echo   CharlaBot - WhatsApp en vivo para la charla
echo   -------------------------------------------
set "CB=%LOCALAPPDATA%\CharlaBot"
if not exist "%CB%" mkdir "%CB%"
set "NV=v22.23.3"
set "NODE=%CB%\node-%NV%.exe"
if exist "%NODE%" goto run
echo.
echo   Primera vez en esta PC: descargo Node.js (unos 36 MB). Tarda 1 o 2 minutos...
echo.
set "ZIP=%CB%\node.zip"
set "TMPD=%CB%\tmp"
if exist "%TMPD%" rmdir /s /q "%TMPD%"
mkdir "%TMPD%"
curl.exe -L --fail --progress-bar -o "%ZIP%" "https://nodejs.org/dist/%NV%/node-%NV%-win-x64.zip"
if not exist "%ZIP%" powershell -NoProfile -ExecutionPolicy Bypass -Command "$ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol='Tls12'; Invoke-WebRequest -UseBasicParsing -Uri ('https://nodejs.org/dist/'+$env:NV+'/node-'+$env:NV+'-win-x64.zip') -OutFile $env:ZIP"
if exist "%ZIP%" tar -xf "%ZIP%" -C "%TMPD%" "node-%NV%-win-x64/node.exe"
if not exist "%TMPD%\node-%NV%-win-x64\node.exe" if exist "%ZIP%" powershell -NoProfile -ExecutionPolicy Bypass -Command "Expand-Archive -LiteralPath $env:ZIP -DestinationPath $env:TMPD -Force"
if exist "%TMPD%\node-%NV%-win-x64\node.exe" move /y "%TMPD%\node-%NV%-win-x64\node.exe" "%NODE%" >nul
if not exist "%NODE%" echo   Pruebo descarga directa, unos 90 MB...
if not exist "%NODE%" curl.exe -L --fail --progress-bar -o "%NODE%" "https://nodejs.org/dist/%NV%/win-x64/node.exe"
if exist "%ZIP%" del /f /q "%ZIP%" >nul 2>nul
if exist "%TMPD%" rmdir /s /q "%TMPD%" >nul 2>nul
if exist "%NODE%" goto run
echo.
echo   No pude descargar Node.js. Revisa que haya internet y volve a abrir este archivo.
echo.
pause
exit /b 1
:run
echo.
"%NODE%" "%~f0"
echo.
echo   CharlaBot se cerro. Podes cerrar esta ventana (o volver a abrir el archivo).
pause >nul
exit /b 0
*/

